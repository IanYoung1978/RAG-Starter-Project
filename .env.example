# Copy this file to .env and change values if you want to.
# .env is ignored by git, so local settings never get committed.
# Everything also has a default in docker-compose.yml, so .env is optional.

# Database login. Only reachable from this machine, so simple values are fine.
POSTGRES_USER=brew
POSTGRES_PASSWORD=brew
POSTGRES_DB=brew

# Models served by Ollama. Change these to try other models, e.g. qwen3:8b.
CHAT_MODEL=llama3.1:8b
EMBED_MODEL=nomic-embed-text
